# Kurox local / shared environment (copy to .env — never commit secrets)

ENVIRONMENT=development
WEB_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:8000
JWT_SECRET=change-me-in-development-only-use-32+chars
JWT_REFRESH_SECRET=change-me-refresh-secret-use-32+chars
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
DATABASE_URL=postgresql+psycopg2://kurox:kurox@localhost:5432/kurox
REDIS_URL=redis://localhost:6379/0
EMAIL_BACKEND=console
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./var/storage
S3_ENDPOINT=
S3_BUCKET=kurox
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
KMS_KEY=dev-only-not-for-production
VITE_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
